			"model.test.view.orders.dimension.status": [
				[1, "view", "orders", "dimension", "status"]
			],
			"model.test.view.orders.dimension.refined_dim": [
				[1, "view", "+orders", 0, "dimension", "refined_dim"]
			]
		}
	}
}
