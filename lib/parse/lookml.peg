{
	/* Grammar produces a clean Abstract Syntax Tree (AST) */
}

// An `Element` wraps a value in the AST
// A `Declaration` represents a type, optional name, and an element/body

declarationSet = ds:(declarationOr_)* {
	return {
		type: 'lookml',
		declarations: ds
	};
}

declarationOr_  = 
	whitespace
	/ comment
	/ objectDeclaration
	/ blockDeclaration
	/ genericDeclaration

objectDeclaration =
	$type:atom _1:_ ":" _2:_ $name:atom? _3:_ "{" _4:_ el:declarationSet _5:_ "}"
	{
		return {
			type: 'object',
			declarationType: $type,
			...($name ? { name: $name } : {}),
			value: el,
			syntax: { _1, _2, _3, _4, _5 }
		};
	}

blockDeclaration =
	$type:blockAtom _1:_ ":" el:doubleSemiBlockElement
	{
		return {
			type: 'block',
			declarationType: $type,
			value: el,
			syntax: { _1 }
		};
	}
	
genericDeclaration = 
	$type:atom _1:_ ":" _2:_ el:(emptyListElement / listElement / mapElement / quotedStringElement / atomElement)
	{
		return {
			type: 'generic',
			declarationType: $type,
			value: el,
			syntax: { _1, _2 }
		};
	}

emptyListElement = 
	"[" _:_ "]" 
	{
		return {
			type: 'empty_list',
			syntax: { _ }
		};
	}

listElement =
	"[" _0:_ln leading:(_ ",")?
	body:( _ stringOrAtomElement _ ","  _ln )*
	tail:( _ stringOrAtomElement _ ","? _   )?
	_last:_
	"]" 
	{
		const bodyItems = body.map(([_1, el]) => el);
		const tailItems = tail ? [tail[1]] : [];
		return {
			type: 'list',
			items: [...bodyItems, ...tailItems],
			syntax: {
				_0,
				leading,
				bodyRaw: body,
				tailRaw: tail,
				_last
			}
		};
	}

mapElement = 
	"[" _0:_ln leading:(_ ",")?
	body:( _ atom _ ":" _ stringOrAtomElement _ ","  _ln )*
	tail:( _ atom _ ":" _ stringOrAtomElement _ ","? _   )? 
	_last:_
	"]" 
	{
		const bodyEntries = body.map(([_1, key, _2, colon, _3, el]) => ({ key, value: el }));
		const tailEntries = tail ? [{ key: tail[1], value: tail[5] }] : [];
		return {
			type: 'map',
			entries: [...bodyEntries, ...tailEntries],
			syntax: {
				_0,
				leading,
				bodyRaw: body,
				tailRaw: tail,
				_last
			}
		};
	}

doubleSemiBlockElement =
	chars:([^;] / ( ";" [^;] ))* ";;" 
	{
		return {
			type: 'double_semi_block',
			value: chars.join('')
		};
	}

quotedStringElement =
	"\"" chars:( stringLiteralCharacter / stringEscapedCharacter )* "\""
	{
		return {
			type: 'string',
			value: chars.join('')
		};
	}

stringLiteralCharacter = [^"\\]
stringEscapedCharacter = "\\" ch:. {return ch;}

atomElement = 
	chars:[-+_a-zA-Z0-9\.]+ maybeStar:"*"? 
	{
		const str = chars.join('') + (maybeStar || '');
		return {
			type: 'atom',
			value: str == "yes" ? true : str == "no" ? false : str,
			raw: str
		};
	}

stringOrAtomElement = quotedStringElement / atomElement

atom = chars:[-+_a-zA-Z0-9\.]+ {return chars.join('')}
blockAtom = blockType:("sql"/"html"/"expr") chars:[-_a-zA-Z0-9]* {return blockType+chars.join('')}

_  = (whitespace / comment)*
_ln = (inlineWhitespace / comment)*

whitespace = chars:[ \t\n\r]+ {return { type: 'whitespace', value: chars.join('') };}
inlineWhitespace = chars:[ \t]+ {return { type: 'whitespace', value: chars.join('') };}
comment = "#" chars:[^\n\r]* newline:[\n\r]? {return { type: 'comment', value: "#" + chars.join('') + (newline||'') };}
